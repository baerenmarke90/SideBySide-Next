{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "SideBySide Design Tokens",
    "version": "1.0.0",
    "status": "foundation",
    "updated": "2026-08-24",
    "description": "Shared semantic tokens for the SideBySide WebApp and smartphone apps. Platform adapters may translate units, but not token meaning."
  },
  "color": {
    "$type": "color",
    "base": {
      "white": { "$value": "#FFFFFF" },
      "ink": { "$value": "#211A2B" },
      "violet700": { "$value": "#6638DC" },
      "violet600": { "$value": "#7C4DFF" },
      "violet100": { "$value": "#EEE7FF" },
      "blue700": { "$value": "#1769AA" },
      "blue100": { "$value": "#E7F2FF" },
      "mint700": { "$value": "#237A65" },
      "mint500": { "$value": "#36AE97" },
      "mint100": { "$value": "#E3F6F1" },
      "amber800": { "$value": "#7A5100" },
      "amber100": { "$value": "#FFF2D5" },
      "pink700": { "$value": "#A61F51" },
      "pink100": { "$value": "#FFE7EE" },
      "red700": { "$value": "#A4133C" },
      "red100": { "$value": "#FFE7EE" },
      "neutral900": { "$value": "#211A2B" },
      "neutral700": { "$value": "#51485C" },
      "neutral500": { "$value": "#756C80" },
      "neutral300": { "$value": "#CFC7D7" },
      "neutral200": { "$value": "#E6E0EB" },
      "neutral100": { "$value": "#F2EEF5" },
      "neutral050": { "$value": "#FAF8FC" },
      "focus": { "$value": "#005FCC" }
    },
    "semantic": {
      "background": { "$value": "#FAF8FC" },
      "surface": { "$value": "#FFFFFF" },
      "surfaceSubtle": { "$value": "#F2EEF5" },
      "surfaceRaised": { "$value": "#FFFFFF" },
      "textPrimary": { "$value": "#211A2B" },
      "textSecondary": { "$value": "#51485C" },
      "textMuted": { "$value": "#756C80" },
      "textInverse": { "$value": "#FFFFFF" },
      "border": { "$value": "#CFC7D7" },
      "borderSubtle": { "$value": "#E6E0EB" },
      "brand": { "$value": "#7C4DFF" },
      "brandStrong": { "$value": "#6638DC" },
      "brandSurface": { "$value": "#EEE7FF" },
      "technical": { "$value": "#1769AA" },
      "technicalSurface": { "$value": "#E7F2FF" },
      "shared": { "$value": "#237A65" },
      "sharedAccent": { "$value": "#36AE97" },
      "sharedSurface": { "$value": "#E3F6F1" },
      "discovery": { "$value": "#7A5100" },
      "discoverySurface": { "$value": "#FFF2D5" },
      "private": { "$value": "#A61F51" },
      "privateSurface": { "$value": "#FFE7EE" },
      "success": { "$value": "#237A65" },
      "successSurface": { "$value": "#E3F6F1" },
      "warning": { "$value": "#7A5100" },
      "warningSurface": { "$value": "#FFF2D5" },
      "error": { "$value": "#A4133C" },
      "errorSurface": { "$value": "#FFE7EE" },
      "focus": { "$value": "#005FCC" },
      "disabledText": { "$value": "#756C80" },
      "disabledSurface": { "$value": "#E6E0EB" },
      "scrim": { "$value": "#211A2BCC" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Fraunces", "Georgia", "serif"] },
      "ui": { "$value": ["Inter", "Arial", "sans-serif"] },
      "system": { "$value": ["system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": ["Fraunces", "Georgia", "serif"],
        "fontSize": "48px",
        "fontWeight": 600,
        "letterSpacing": "-0.02em",
        "lineHeight": 1.08
      }
    },
    "heading1": {
      "$value": {
        "fontFamily": ["Inter", "Arial", "sans-serif"],
        "fontSize": "36px",
        "fontWeight": 700,
        "letterSpacing": "-0.015em",
        "lineHeight": 1.15
      }
    },
    "heading2": {
      "$value": {
        "fontFamily": ["Inter", "Arial", "sans-serif"],
        "fontSize": "28px",
        "fontWeight": 700,
        "letterSpacing": "-0.01em",
        "lineHeight": 1.2
      }
    },
    "heading3": {
      "$value": {
        "fontFamily": ["Inter", "Arial", "sans-serif"],
        "fontSize": "22px",
        "fontWeight": 600,
        "letterSpacing": "0em",
        "lineHeight": 1.25
      }
    },
    "title": {
      "$value": {
        "fontFamily": ["Inter", "Arial", "sans-serif"],
        "fontSize": "18px",
        "fontWeight": 600,
        "letterSpacing": "0em",
        "lineHeight": 1.35
      }
    },
    "body": {
      "$value": {
        "fontFamily": ["Inter", "Arial", "sans-serif"],
        "fontSize": "16px",
        "fontWeight": 400,
        "letterSpacing": "0em",
        "lineHeight": 1.5
      }
    },
    "bodySmall": {
      "$value": {
        "fontFamily": ["Inter", "Arial", "sans-serif"],
        "fontSize": "14px",
        "fontWeight": 400,
        "letterSpacing": "0em",
        "lineHeight": 1.45
      }
    },
    "label": {
      "$value": {
        "fontFamily": ["Inter", "Arial", "sans-serif"],
        "fontSize": "14px",
        "fontWeight": 600,
        "letterSpacing": "0.01em",
        "lineHeight": 1.2
      }
    },
    "meta": {
      "$value": {
        "fontFamily": ["Inter", "Arial", "sans-serif"],
        "fontSize": "12px",
        "fontWeight": 500,
        "letterSpacing": "0.02em",
        "lineHeight": 1.35
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "small": { "$value": "8px" },
    "medium": { "$value": "12px" },
    "large": { "$value": "16px" },
    "card": { "$value": "20px" },
    "sheet": { "$value": "24px" },
    "hero": { "$value": "32px" },
    "pill": { "$value": "999px" }
  },
  "size": {
    "touchTarget": {
      "$type": "dimension",
      "webMinimum": { "$value": "44px" },
      "appMinimum": { "$value": "48px" }
    },
    "icon": {
      "$type": "dimension",
      "small": { "$value": "16px" },
      "medium": { "$value": "20px" },
      "standard": { "$value": "24px" },
      "large": { "$value": "32px" }
    },
    "control": {
      "$type": "dimension",
      "compact": { "$value": "36px" },
      "standard": { "$value": "44px" },
      "comfortable": { "$value": "48px" }
    }
  },
  "layout": {
    "contentMax": { "$type": "dimension", "$value": "1200px" },
    "readingMax": { "$type": "dimension", "$value": "720px" },
    "mobileGutter": { "$type": "dimension", "$value": "20px" },
    "webGutterMin": { "$type": "dimension", "$value": "24px" },
    "webGutterMax": { "$type": "dimension", "$value": "64px" },
    "navigationRail": { "$type": "dimension", "$value": "80px" },
    "sidebar": { "$type": "dimension", "$value": "256px" },
    "detailPaneMin": { "$type": "dimension", "$value": "320px" },
    "detailPaneMax": { "$type": "dimension", "$value": "480px" },
    "breakpoint": {
      "compactMax": { "$type": "dimension", "$value": "599px" },
      "mediumMin": { "$type": "dimension", "$value": "600px" },
      "mediumMax": { "$type": "dimension", "$value": "839px" },
      "expandedMin": { "$type": "dimension", "$value": "840px" }
    }
  },
  "border": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "strong": { "$value": "2px" },
    "focus": { "$value": "3px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms" },
      "fast": { "$value": "120ms" },
      "standard": { "$value": "180ms" },
      "emphasized": { "$value": "280ms" },
      "maximum": { "$value": "320ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0, 0, 0.2, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": "#211A2B14",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "10px",
        "spread": "0px"
      }
    },
    "overlay": {
      "$value": {
        "color": "#211A2B24",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "32px",
        "spread": "0px"
      }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.56 },
    "subtle": { "$value": 0.72 },
    "opaque": { "$value": 1 }
  },
  "zIndex": {
    "$type": "number",
    "base": { "$value": 0 },
    "sticky": { "$value": 100 },
    "overlay": { "$value": 400 },
    "modal": { "$value": 500 },
    "toast": { "$value": 600 }
  }
}
