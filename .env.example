# Kopieren nach .env und ausfuellen. .env wird nicht eingecheckt.
#
# Diese Datei ist fuer den LOKALEN TESTBETRIEB vorbereitet: `cp .env.example
# .env`, POSTGRES_PASSWORD ersetzen, `docker compose up -d` - fertig. Web-PoC
# und API sind dann nur ueber 127.0.0.1 erreichbar, Post landet im Log, und es braucht
# weder SMTP-Zugang noch HTTPS-Domain.
#
# Fuer ECHTEN BETRIEB sind zusaetzlich die im Abschnitt "Produktionsbetrieb"
# unten aufgefuehrten Werte Pflicht. Fehlt einer davon, verweigert die
# Anwendung den Start - das ist Absicht. Die vollstaendige Checkliste steht in
# docs/SELF-HOSTING.md.
#
# Arcane verwendet compose.arcane.yaml. Die Arcane-spezifischen Quellangaben
# stehen am Ende dieser Datei und sind in docs/ARCANE.md erklaert.

# development = lokaler Testbetrieb (Standard), production = echter Betrieb.
SBS_ENVIRONMENT=development

POSTGRES_USER=sidebyside
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=sidebyside

# Host-Port der API. 8000 ist nur der Vorgabewert und muss auf dem Docker-Host
# frei sein. Ist er bereits belegt, vor dem Start einen freien Port waehlen,
# z. B. API_PORT=8010. Der Container selbst lauscht weiterhin auf Port 8000.
# SBS_PUBLIC_BASE_URL bleibt die Web-Origin und richtet sich nach WEB_PORT.
API_PORT=8000

# Host-Port des technischen Web-PoC.
WEB_PORT=8080

# Adresse des Docker-Hosts, an der API_PORT und WEB_PORT veroeffentlicht werden.
# Der sichere Standard ist Loopback. Steht der TLS-Reverse-Proxy auf einem
# anderen Host im privaten Netz, hier gezielt die private Adresse des
# Docker-Hosts eintragen, z. B. SBS_BIND_IP=192.168.10.20. Nicht unnoetig
# 0.0.0.0 verwenden.
SBS_BIND_IP=127.0.0.1

# Der G2-Referenzflow hat bewusst noch keine Space-Auswahl. Diese nicht geheime
# UUID wird beim Image-Build eingebettet. Ohne Wert startet der Webdienst
# trotzdem und zeigt einen klaren Betreiberhinweis.
SBS_WEB_SPACE_ID=

# Vor der allerersten Registrierung lokal erzeugen und nur in der eigenen
# .env setzen. Mindestens 32 Zeichen; nach erfolgreichem Bootstrap entfernen.
# SBS_BOOTSTRAP_TOKEN=

# --- Produktionsbetrieb: ab hier Pflicht, sobald SBS_ENVIRONMENT=production ---
#
# Signiert opake API-Cursor. Fuer jede Produktionsinstanz zufaellig erzeugen,
# mindestens 32 Zeichen und dauerhaft stabil halten. Nicht mit DB-Passwort,
# Bootstrap-Token oder einem anderen Secret wiederverwenden. Im Testbetrieb
# wird ohne diesen Wert ein lokaler Rueckfallwert verwendet.
#
#   openssl rand -base64 48
#
# SBS_CURSOR_SIGNING_KEY=

# JSON-Liste der Hostnamen, fuer die die API antworten darf. Fuer einen
# HTTPS-Reverse-Proxy dessen oeffentlichen Namen ergaenzen; niemals "*".
SBS_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Kleinster IP-/CIDR-Bereich des Reverse-Proxys, dessen X-Forwarded-*-Header
# Uvicorn vertrauen darf. Ohne Proxy bleibt der sichere Loopback-Standard.
TRUSTED_PROXY_IPS=127.0.0.1

# Die oeffentliche Adresse dieser Instanz. Sie steht in jedem Anmelde- und
# Wiederherstellungslink. Im lokalen Test ist das die Web-Origin und der Port
# muss zu WEB_PORT passen. In Produktion muss die Adresse mit https://
# beginnen; dort ist der interne Host-Port kein Bestandteil dieser URL.
SBS_PUBLIC_BASE_URL=http://localhost:8080

# Medien liegen standardmaessig im lokalen Compose-Volume. Fuer einen privaten
# S3-kompatiblen Bucket auf "s3" umstellen und die Werte darunter setzen.
SBS_MEDIA_STORE=local
# SBS_S3_ENDPOINT=https://s3.example.com
# SBS_S3_REGION=eu-central-1
# SBS_S3_BUCKET=sidebyside-private
# SBS_S3_ACCESS_KEY_ID=
# SBS_S3_SECRET_ACCESS_KEY=
# SBS_S3_SESSION_TOKEN=
# Compose uebernimmt SBS_S3_ENDPOINT automatisch als exakt erlaubte
# `connect-src`-Origin in die Web-CSP. Keine zweite CSP- oder Browser-
# Konfiguration ist fuer den normalen Self-Hosted-Pfad erforderlich.

# Ausgehende Post. Drei Moeglichkeiten:
#
#   log   Nachricht landet im Log. NUR fuer den lokalen Testbetrieb - der
#         Anmeldelink stuende sonst im Log. In Produktion abgelehnt.
#   smtp  echter Versand ueber den unten konfigurierten Server.
#   none  diese Instanz versendet keine E-Mail. Magic Link, Passwort-
#         Recovery und Adressbestaetigung sind dann nicht verfuegbar und
#         antworten mit 503; Anmeldung laeuft ueber Passwort, Passkey und
#         OIDC. In Produktion zulaessig - ein SMTP-Zugang ist keine
#         Startvoraussetzung.
SBS_MAIL_TRANSPORT=log
SBS_MAIL_FROM=no-reply@localhost
# SBS_SMTP_HOST=
# SBS_SMTP_PORT=587
# SBS_SMTP_USERNAME=
# SBS_SMTP_PASSWORD=
# SBS_SMTP_STARTTLS=true

# OIDC-Verbindungen als JSON-Liste. Jede Verbindung bekommt eine frei
# gewaehlte id; sie steht im Pfad der Anmelde-Endpunkte. Der issuer muss
# https sein. Pocket ID ist hier eine gewoehnliche Verbindung.
# SBS_OIDC_CONNECTIONS=[{"id":"pocket","issuer":"https://id.example","client_id":"sidebyside","client_secret":"...","redirect_uri":"https://app.example/oidc"}]

# WebAuthn/Passkeys. Ohne eigene Werte wird die Relying Party aus
# SBS_PUBLIC_BASE_URL abgeleitet - ein Passkey fuer "app.example" gilt
# damit nicht auf einer anderen Domain.
# SBS_WEBAUTHN_RP_ID=app.example
# SBS_WEBAUTHN_RP_NAME=SideBySide
# SBS_WEBAUTHN_ORIGINS=["https://app.example"]

# --- Nur fuer compose.arcane.yaml / Remote-Workspace ---
#
# Quelle fuer die Remote-Git-Build-Kontexte. Keine Zugangsdaten oder Tokens in
# diese URL einbetten. Bei einem privaten Repository muss die Build-Umgebung
# die Git-Authentifizierung bereitstellen; siehe docs/ARCANE.md.
SBS_SOURCE_REPOSITORY=https://github.com/baerenmarke90/SideBySide-Next.git

# Fuer Tests ist main ausreichend. Fuer reproduzierbare Produktion einen
# unveraenderlichen Release-Tag verwenden.
SBS_SOURCE_REF=main
