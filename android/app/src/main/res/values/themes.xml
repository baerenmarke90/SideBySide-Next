<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SideBySideReference" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#FAF8FC</item>
        <!-- API 26 has no windowLightNavigationBar theme attribute yet. Keep
             launch-time icons readable; SideBySideTheme switches this to the
             light background with dark icons as soon as Compose is active. -->
        <item name="android:navigationBarColor">#211A2B</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
