<?xml version="1.0" encoding="utf-8"?>
<!--
    The languages this app is actually written in.

    SideBySide is German-only today. Declaring that here rather than leaving it
    implied by the unqualified `values/` folder is what lets Android resolve
    library-provided strings to the same language as the product's own, instead
    of to whatever the device happens to be set to.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="de" />
</locale-config>
