# Persistent SideBySide Development/Staging instance.
#
# This file is a template only. Copy/import it into a dedicated Development
# deployment and replace every secret. Do not reuse Production values.
# See docs/DEVELOPMENT-AND-RELEASE-ENVIRONMENTS.md.

SBS_ENVIRONMENT=development
SBS_DEPLOYMENT=self_hosted
SBS_DEMO_MODE=false
SBS_DEMO_MODE_RESET_TIMER=false

# Arcane / remote Git build context. Development normally follows main. An
# explicit candidate commit/tag may be used during release-candidate acceptance.
SBS_SOURCE_REPOSITORY=https://github.com/baerenmarke90/SideBySide-Next.git
SBS_SOURCE_REF=main

# Use Development-only database identity and a dedicated Compose/Arcane project.
POSTGRES_USER=sidebyside_dev
POSTGRES_PASSWORD=replace-with-development-only-secret
POSTGRES_DB=sidebyside_dev

# Generate a Development-only value with e.g. `openssl rand -base64 48`.
SBS_CURSOR_SIGNING_KEY=replace-with-development-only-signing-key

# Example only; use the actual protected Development origin.
SBS_PUBLIC_BASE_URL=https://dev.sidebyside.example
SBS_ALLOWED_HOSTS=["dev.sidebyside.example"]
TRUSTED_PROXY_IPS=127.0.0.1

# Development must not accidentally expose the services broadly. Keep loopback
# when the reverse proxy is on the same host, otherwise bind only the intended
# private host address.
SBS_BIND_IP=127.0.0.1
API_PORT=8000
WEB_PORT=8080

# Mail is optional. `none` is preferable to using Production SMTP credentials.
SBS_MAIL_TRANSPORT=none
SBS_MAIL_FROM=no-reply@dev.sidebyside.example

# Local MediaStore is the safest default for Development. If S3 is used, provide
# a Development-only bucket/prefix and Development-only credentials.
SBS_MEDIA_STORE=local

# Configure separate Development OIDC / WebAuthn registrations when used.
SBS_OIDC_CONNECTIONS=[]
SBS_WEBAUTHN_RP_ID=dev.sidebyside.example
SBS_WEBAUTHN_RP_NAME=SidebySide Development
SBS_WEBAUTHN_ORIGINS=["https://dev.sidebyside.example"]

# Optional first-registration bootstrap. Generate separately and remove after
# successful bootstrap. Never copy the Production bootstrap token.
# SBS_BOOTSTRAP_TOKEN=
