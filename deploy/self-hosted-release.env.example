# Released Self-Hosted deployment template.
#
# Copy to .env in the extracted Self-Hosted operator bundle. This file does NOT
# set COMPOSE_FILE: repository-root compose.yaml is the single released runtime
# topology and consumes prebuilt OCI images instead of building application source.
#
# Released Production is operated through:
#   python3 scripts/self_hosted_release.py --env-file .env <operation>
# Do not replace the launcher with raw Compose pull/bootstrap/start commands.

COMPOSE_PROFILES=self-hosted
COMPOSE_PROJECT_NAME=eimir-self-hosted
SBS_ENVIRONMENT=production
SBS_DEPLOYMENT=self_hosted

# Product version published by the protected release workflow. The mandatory
# Production launcher verifies that the actual backend/Web image references carry
# exactly this version before pull/bootstrap/start.
SBS_RELEASE_VERSION=0.1.0

# For byte-level locking, set both digest-qualified references from the same
# GitHub Release's self-hosted-image-identity.json. The v0.1.0 tag component must
# still match SBS_RELEASE_VERSION; changing both overrides to another version is
# intentionally rejected.
# SBS_SELF_HOSTED_BACKEND_IMAGE=ghcr.io/baerenmarke90/eimir-backend:v0.1.0@sha256:<digest>
# SBS_SELF_HOSTED_WEB_IMAGE=ghcr.io/baerenmarke90/eimir-web:v0.1.0@sha256:<digest>

POSTGRES_USER=sidebyside
POSTGRES_PASSWORD=replace-with-production-database-password
POSTGRES_DB=sidebyside

API_PORT=8000
WEB_PORT=8080
SBS_BIND_IP=127.0.0.1

SBS_PUBLIC_BASE_URL=https://replace-with-public-origin.example
SBS_ALLOWED_HOSTS=["replace-with-public-origin.example"]
TRUSTED_PROXY_IPS=127.0.0.1
SBS_CURSOR_SIGNING_KEY=replace-with-production-only-signing-key-at-least-32-chars

# Leave blank only during a genuinely new installation until the released
# launcher operation bootstrap-deletion-authority creates UUID + forward journal
# together. Established installations must restore their existing authority.
SBS_ACCOUNT_DELETION_INSTANCE_ID=
SBS_SERVER_ADMIN_EMAILS=[]
SBS_BOOTSTRAP_TOKEN=

SBS_DEMO_MODE=false
SBS_DEMO_MODE_RESET_TIMER=false
SBS_DEMO_MODE_RESET_INTERVAL=6h
SBS_DEMO_PUBLIC_URL=

SBS_MEDIA_STORE=local
SBS_S3_ENDPOINT=
SBS_S3_REGION=us-east-1
SBS_S3_BUCKET=
SBS_S3_ACCESS_KEY_ID=
SBS_S3_SECRET_ACCESS_KEY=
SBS_S3_SESSION_TOKEN=

# Production may use smtp or none; log is rejected by the application.
SBS_MAIL_TRANSPORT=none
SBS_MAIL_FROM=no-reply@replace-with-public-origin.example
SBS_SMTP_HOST=
SBS_SMTP_PORT=587
SBS_SMTP_USERNAME=
SBS_SMTP_PASSWORD=
SBS_SMTP_STARTTLS=true

SBS_OIDC_CONNECTIONS=[]
SBS_WEBAUTHN_RP_ID=
SBS_WEBAUTHN_RP_NAME=SideBySide
SBS_WEBAUTHN_ORIGINS=[]
