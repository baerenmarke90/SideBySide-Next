# Cloud/Managed v1 Production template for SideBySide.
#
# Copy these values into the managed platform's own secret/config store for a
# dedicated Production project. Never reuse a Development, Demo or another
# Cloud project's database, bucket, signing key, bootstrap token or provider
# credentials. Authoritative contract: docs/m6/CLOUD-MANAGED-TOPOLOGY.md.
#
# Cloud/Managed uses the repository-root compose.yaml with the cloud profile.
# There is no second Cloud-specific Compose manifest.

COMPOSE_PROJECT_NAME=sidebyside-cloud-production
COMPOSE_PROFILES=cloud

SBS_ENVIRONMENT=production
SBS_DEPLOYMENT=cloud

# Exact #519 release images after the build-once archives have been promoted to
# the managed registry. Production must use digest-pinned OCI references such as
# registry.example/sidebyside-backend@sha256:<digest>. A tag may be retained
# before @sha256 for human readability, but a tag-only reference -- including
# latest, main, v1.0.0 or any other SemVer/custom tag -- is not immutable
# deployment identity. Set both values before using the cloud profile. Leaving
# either empty resolves to a deliberately non-runnable sentinel in compose.yaml;
# there is no source-build fallback.
SBS_BACKEND_IMAGE=
SBS_WEB_IMAGE=

# Managed PostgreSQL connection string. Must resolve to a private-network
# endpoint that is not publicly reachable.
SBS_DATABASE_URL=postgresql+psycopg://replace-with-managed-db-user:replace-with-managed-db-password@replace-with-managed-db-private-host:5432/sidebyside

# Managed platform ingress (load balancer / reverse proxy) is the only public
# origin. Replace with the exact Production public origin and its source
# address range; never "*".
SBS_PUBLIC_BASE_URL=https://replace-with-production-public-origin.example
SBS_ALLOWED_HOSTS=["replace-with-production-public-origin.example"]
TRUSTED_PROXY_IPS=replace-with-managed-load-balancer-source-range

# Production-only signing key, at least 32 characters, never shared with
# Development/Demo/another Cloud project.
SBS_CURSOR_SIGNING_KEY=replace-with-production-only-signing-key-at-least-32-chars

# Self-service Account deletion authority. Do NOT invent this UUID by hand.
# Before the first normal API rollout, run the backend image as an explicit
# one-shot bootstrap job with the final shared deletion-journal volume mounted,
# SBS_ACCOUNT_DELETION_JOURNAL_PATH set to the canonical path, no
# SBS_ACCOUNT_DELETION_INSTANCE_ID, and:
#
#   python -m sidebyside.identity.deletion_bootstrap --confirm-new-installation
#
# Store the UUID printed by that job here and in protected operator config.
# Normal Production startup validates the existing journal and exact UUID; it
# never creates an empty replacement. If the configured journal later goes
# missing, rollout/startup must remain failed until the newest protected journal
# is recovered. Never re-run bootstrap to repair an established environment.
#
# docs/m6/CLOUD-MANAGED-ACCOUNT-DELETION-AUTHORITY.md records the binding
# bootstrap/startup distinction. The `deletion_journal_data` volume declared by
# compose.yaml must be a shared/ReadWriteMany-equivalent network volume reachable
# identically by every cloud-api (and cloud-worker, if applicable) replica, with
# correct cross-client POSIX advisory-lock (fcntl) support. A per-replica local
# disk is not supported for this path.
SBS_ACCOUNT_DELETION_INSTANCE_ID=

# ServerAdmin is instance-wide and independent of Space membership. Replace
# the empty JSON list with verified account email addresses that may operate
# this Production instance, for example ["admin@example.com"].
SBS_SERVER_ADMIN_EMAILS=[]

# MediaStore backend: an operator/topology choice, not a fixed requirement
# (docs/m6/CLOUD-MANAGED-TOPOLOGY.md §3.3). `local` (the default, matching
# Self-Hosted) needs the `media_data` volume from compose.yaml; that volume must
# be a shared/ReadWriteMany-equivalent network volume once more than one
# cloud-api/cloud-worker replica is deployed. `s3` needs the object-storage
# variables below instead.
SBS_MEDIA_STORE=local

# Uncomment and fill in to switch to the S3-compatible backend instead of
# `local`. Use a Production-only private bucket and least-privilege
# credentials scoped to it; never the Development/Demo bucket. The configured
# endpoint is client-facing because presigned PUT/GET capabilities use that
# exact origin, so Production requires HTTPS even when the object store is
# otherwise reachable over a private network. This does not make S3 mandatory;
# `local` remains a supported topology choice.
# SBS_MEDIA_STORE=s3
# SBS_S3_ENDPOINT=https://replace-with-managed-s3-endpoint.example
# SBS_S3_REGION=replace-with-region
# SBS_S3_BUCKET=sidebyside-production-private
# SBS_S3_ACCESS_KEY_ID=replace-with-production-only-access-key-id
# SBS_S3_SECRET_ACCESS_KEY=replace-with-production-only-secret-access-key
# SBS_S3_SESSION_TOKEN=

# Production must send real mail, never `log` (which would write live
# one-time authentication tokens to shared logs). Use `smtp` once credentials
# are configured, or `none` to explicitly run without mail-dependent sign-in.
SBS_MAIL_TRANSPORT=none
SBS_MAIL_FROM=no-reply@replace-with-production-public-origin.example
# SBS_SMTP_HOST=
# SBS_SMTP_PORT=587
# SBS_SMTP_USERNAME=
# SBS_SMTP_PASSWORD=
# SBS_SMTP_STARTTLS=true

# Configure Production-only OIDC/WebAuthn callbacks/clients against the exact
# managed public origin above.
SBS_OIDC_CONNECTIONS=[]
SBS_WEBAUTHN_RP_ID=
SBS_WEBAUTHN_RP_NAME=SideBySide
SBS_WEBAUTHN_ORIGINS=[]

# Initial bootstrap only. Remove from the platform's secret store after the
# first Production ServerAdmin account exists.
SBS_BOOTSTRAP_TOKEN=replace-with-production-only-bootstrap-token-at-least-32-chars
