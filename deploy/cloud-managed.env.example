# Cloud/Managed v1 Production template for SideBySide.
#
# Copy these values into the managed platform's own secret/config store for a
# dedicated Production project. Never reuse a Development, Demo or another
# Cloud project's database, bucket, signing key, bootstrap token or provider
# credentials. Authoritative contract: docs/m6/CLOUD-MANAGED-TOPOLOGY.md.
#
# Deploy with deploy/compose.cloud.yml (or the managed-platform descriptor
# generated from it), never the Self-Hosted compose.yaml/compose.arcane.yaml.

COMPOSE_PROJECT_NAME=sidebyside-cloud-production

SBS_ENVIRONMENT=production
SBS_DEPLOYMENT=cloud

# The exact immutable #519 release image references pushed by the operator to
# the managed platform's registry (docs/m6/CLOUD-MANAGED-TOPOLOGY.md §4.1).
# Always the release tag `v<product-version>`. Never `latest`, `main`, or any
# other floating/branch reference.
SBS_BACKEND_IMAGE=replace-with-registry/sidebyside-backend:v<product-version>
SBS_WEB_IMAGE=replace-with-registry/sidebyside-web:v<product-version>

# Managed PostgreSQL connection string. Must resolve to a private-network
# endpoint that is not publicly reachable.
SBS_DATABASE_URL=postgresql+psycopg://replace-with-managed-db-user:replace-with-managed-db-password@replace-with-managed-db-private-host:5432/sidebyside

# Managed platform ingress (load balancer / reverse proxy) is the only public
# origin. Replace with the exact Production public origin and its source
# address range; never "*".
SBS_PUBLIC_BASE_URL=https://replace-with-production-public-origin.example
SBS_ALLOWED_HOSTS=["replace-with-production-public-origin.example"]
TRUSTED_PROXY_IPS=replace-with-managed-load-balancer-source-range

# Production-only signing key, at least 32 characters, never shared with
# Development/Demo/another Cloud project.
SBS_CURSOR_SIGNING_KEY=replace-with-production-only-signing-key-at-least-32-chars

# Self-service Account deletion journal. Generate one Production-only UUID
# before the first deletion request and never change it afterward.
# Example generator: python3 -c 'import uuid; print(uuid.uuid4())'
#
# docs/m6/CLOUD-MANAGED-TOPOLOGY.md §3.5: the mounted volume behind
# deploy/compose.cloud.yml's `deletion_journal_data` volume must be a
# shared/ReadWriteMany-equivalent network volume reachable identically by
# every api (and worker, if applicable) replica, with correct cross-client
# POSIX advisory-lock (fcntl) support. A per-replica local disk is not
# supported for this path.
SBS_ACCOUNT_DELETION_INSTANCE_ID=

# ServerAdmin is instance-wide and independent of Space membership. Replace
# the empty JSON list with verified account email addresses that may operate
# this Production instance, for example ["admin@example.com"].
SBS_SERVER_ADMIN_EMAILS=[]

# Cloud/Managed v1 requires the S3-compatible object-storage MediaStore.
# `local` is not a supported Cloud/Managed Production configuration (see
# docs/m6/CLOUD-MANAGED-TOPOLOGY.md §3.3 and §7). Use a Production-only
# private bucket and least-privilege credentials scoped to it.
SBS_S3_ENDPOINT=https://replace-with-managed-s3-endpoint.example
SBS_S3_REGION=replace-with-region
SBS_S3_BUCKET=sidebyside-production-private
SBS_S3_ACCESS_KEY_ID=replace-with-production-only-access-key-id
SBS_S3_SECRET_ACCESS_KEY=replace-with-production-only-secret-access-key
# SBS_S3_SESSION_TOKEN=

# Production must send real mail, never `log` (which would write live
# one-time authentication tokens to shared logs). Use `smtp` once credentials
# are configured, or `none` to explicitly run without mail-dependent sign-in.
SBS_MAIL_TRANSPORT=none
SBS_MAIL_FROM=no-reply@replace-with-production-public-origin.example
# SBS_SMTP_HOST=
# SBS_SMTP_PORT=587
# SBS_SMTP_USERNAME=
# SBS_SMTP_PASSWORD=
# SBS_SMTP_STARTTLS=true

# Configure Production-only OIDC/WebAuthn callbacks/clients against the exact
# managed public origin above.
SBS_OIDC_CONNECTIONS=[]
SBS_WEBAUTHN_RP_ID=
SBS_WEBAUTHN_RP_NAME=SideBySide
SBS_WEBAUTHN_ORIGINS=[]

# Initial bootstrap only. Remove from the platform's secret store after the
# first Production ServerAdmin account exists.
SBS_BOOTSTRAP_TOKEN=replace-with-production-only-bootstrap-token-at-least-32-chars
