# Entwicklung. Kopieren nach .env.
SBS_ENVIRONMENT=development
SBS_DEPLOYMENT=self_hosted
SBS_DATABASE_URL=postgresql+psycopg://sidebyside:sidebyside@localhost:5432/sidebyside
SBS_MEDIA_ROOT=./data/media

# Nur fuer Integrationstests. Ohne diese Variable werden sie uebersprungen.
SBS_TEST_DATABASE_URL=postgresql+psycopg://sidebyside:sidebyside@localhost:5432/sidebyside_test
